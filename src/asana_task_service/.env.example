# Asana Configuration
# Get your token from: https://app.asana.com/0/developer-console
ASANA_TOKEN=your_asana_personal_access_token

# Asana Project ID (where tasks will be created)
# Find this in your Asana project URL: https://app.asana.com/0/<PROJECT_ID>/list
ASANA_PROJECT_ID=1201234567890123

# Asana Workspace ID (optional - if not using project)
ASANA_WORKSPACE_ID=

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_API_KEY=change-me-generate-a-strong-secret

# Application: development | production
# Set to 'production' to disable /docs and /redoc
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS — comma-separated origins. Leave empty for backend-to-backend (n8n) use.
ALLOWED_ORIGINS=
