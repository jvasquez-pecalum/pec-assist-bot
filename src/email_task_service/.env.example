# Asana service
ASANA_SERVICE_URL=http://asana-task:8000
# Must match SERVICE_API_KEY in asana_task_service/.env
ASANA_SERVICE_API_KEY=change-me-same-as-asana-service-key

# OpenAI
OPENAI_API_KEY=sk-...

# SMTP / IMAP (Office 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=pec.assist@pecalum.com
IMAP_PASSWORD=your_app_password
SENDER_ADDRESS=pec.assist@pecalum.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Microsoft Graph (optional — alternative to IMAP)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_API_KEY=change-me-generate-a-strong-secret

# Application: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS — leave empty for backend-to-backend (n8n) use
ALLOWED_ORIGINS=

# Service
EMAIL_SERVICE_PORT=8001
LOG_FORMAT=json

# Testing toggles (never set to true in production)
TEST_MODE=false
MOCK_OPENAI=false
MOCK_ASANA=false
MOCK_SMTP=false
SKIP_CHANNEL_CHECK=false
